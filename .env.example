# 后端服务
OPSMIND_ENVIRONMENT=development
OPSMIND_DATABASE_URL=sqlite:///./data/opsmind.db
OPSMIND_JWT_SECRET=replace-with-a-long-random-secret
OPSMIND_ACCESS_TOKEN_MINUTES=480
OPSMIND_SEED_DEMO_DATA=true
OPSMIND_DEMO_USER_PASSWORD=OpsMind!2026
OPSMIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AI 模型服务。本地演示建议保留 demo 模式，结果可重复且不需要密钥。
OPSMIND_LLM_MODE=demo
OPSMIND_LLM_BASE_URL=https://api.openai.com/v1
OPSMIND_LLM_API_KEY=
OPSMIND_LLM_MODEL=gpt-4.1-mini
OPSMIND_LLM_TIMEOUT_SECONDS=45

# 前端
VITE_API_URL=http://localhost:8000/api/v1
