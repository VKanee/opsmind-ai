# 复制本文件为仓库根目录的 .env 后再部署
POSTGRES_PASSWORD=replace-with-a-strong-database-password

OPSMIND_JWT_SECRET=replace-with-a-long-random-jwt-secret
OPSMIND_SEED_DEMO_DATA=true
OPSMIND_DEMO_USER_PASSWORD=replace-with-a-strong-demo-password
OPSMIND_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

OPSMIND_LLM_MODE=demo
OPSMIND_LLM_BASE_URL=https://api.openai.com/v1
OPSMIND_LLM_API_KEY=
OPSMIND_LLM_MODEL=gpt-4.1-mini
